# AIA command-center environment reference.
# Copy to .env and adjust. Never commit real secrets.

# --- Daemon bind ---
AIA_BIND=127.0.0.1
AIA_PORT=3000
AIA_DISPATCH_DRY_RUN=1

# --- Paths (optional overrides) ---
# AIA_DATA_DIR=./data
# AIA_KEY_DIR=./data/.keys
# AIA_PACKS_DIR=../packs
# AIA_BACKUP_DIR=./backups
# (restore.sh uses the same AIA_DATA_DIR / AIA_PACKS_DIR / AIA_BACKUP_DIR)
# AIA_AUDIT_OUT_DIR=./audits
# AIA_LEDGER_PATH=./data/ledger.ndjson
# AIA_QUEUE_PATH=./data/active_queue.json
# AIA_SPOOL_PATH=./data/spool.ndjson
# AIA_DEADLETTER_PATH=./data/spool.deadletter.ndjson
# AIA_DAEMON_URL=http://127.0.0.1:3000
# AIA_INGEST_URL=http://127.0.0.1:3000
# AIA_WEBHOOK_SECRET=
# AIA_WATCHDOG_RESTART_CMD=
# AIA_WATCHDOG_TIMEOUT_MS=2500
# AIA_LEDGER_ARCHIVE_DIR=./data/ledger-archives

# --- Grok / SpaceXAI (optional; local meta-prompt fallback without it) ---
# GROK_API_KEY=
# SPACEXAI_API_KEY=

# --- Cold backup encryption (optional) ---
# AIA_AGE_RECIPIENT=
# AIA_GPG_ENCRYPT=1

# --- maintain.sh retention ---
# AIA_LOG_DIR=./logs
# AIA_TMP_MAX_AGE_MIN=60
# AIA_LOG_MAX_LINES=5000
# AIA_LOG_MAX_BYTES=10485760
# AIA_LOG_KEEP=7
