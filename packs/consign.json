{
  "id": "consign",
  "name": "Consignment & resale",
  "family": "Consign It Away",
  "capture": ["photo", "walk-in", "widget"],
  "qualify": ["comps band", "sellable condition", "title present"],
  "do": ["title", "price draft", "channel listing"],
  "collect": ["payout on sale"],
  "follow": ["sold notice", "pickup", "review"],
  "taps": ["price when comps disagree", "payout"],
  "kill": ["stolen / no title / unsellable"],
  "pipes": ["ebay", "square", "consign"],
  "artifacts": ["listing", "payout memo"],
  "fields": {
    "capture": ["title", "kind", "from", "contactName", "phone", "email", "notes", "photoUrl", "provider", "pack"],
    "qualify": ["condition", "titlePresent", "compsLow", "compsHigh", "ask", "risk", "timing", "why"],
    "do": ["draft", "artifact", "provider"],
    "collect": ["amount", "payoutTo", "confirm"],
    "follow": ["followed"],
    "rail": ["killReason", "whoTapped", "promptVersion"]
  },
  "rules": [
    { "text": "Cap title-missing items.", "when": "qualify", "then": "cap", "contains": "title" },
    { "text": "Wait on me before a payout leaves.", "when": "collect", "then": "wait" }
  ],
  "queue": {
    "badge": "Consign",
    "family": "Consign It Away",
    "empty": "Drop a photo of the item. Draft the title. Payout waits on you.",
    "group": "kind",
    "sort": "cap-first",
    "chips": ["list", "title", "payout"],
    "taps": ["copy", "text", "email", "hand", "cap"],
    "never": ["send", "stop", "pay"]
  }
}
