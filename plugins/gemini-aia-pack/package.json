{
  "name": "gemini-aia-pack",
  "version": "1.0.0",
  "description": "Modular Gemini integration pack for Automate It Away (AIA) and AIA Desk AI",
  "type": "module",
  "main": "deploy_gemini_aia_pack.mjs",
  "scripts": {
    "doctor": "node ./doctor.mjs",
    "smoke": "node ./deploy_gemini_aia_pack.mjs",
