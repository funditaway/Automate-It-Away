# Lead Catcher (Official AIA Pack) — example settings. No real secrets here. Copy to .env.local for local runs only.
# Isolated Lead Catcher store (never the shared AIA store or Blob). Default: /tmp/aia-lead-catcher.json
AIA_LC_STORE_PATH=
# MOCK outbox (nothing is sent). Default: /tmp/aia-lead-catcher-outbox.mock.ndjson
AIA_LC_OUTBOX_PATH=
# Minutes a Yes stays valid before Run. Default 60.
AIA_LC_APPROVAL_TTL_MIN=60
# Optional model helper — OFF. Rule-based helper is used when off.
AIA_LC_MODEL_ENABLED=false
AIA_LC_MODEL_ENDPOINT=
AIA_LC_MODEL_NAME=
AIA_LC_MODEL_API_KEY=
# Test runner only: write JSON results here.
AIA_LC_RESULTS_JSON=
